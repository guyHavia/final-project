# Test environment config — safe to commit (no real secrets).
# Used by the test suite instead of .env so dev and test configs stay separate.

NODE_ENV=test
PORT=3000

# MongoDB: a local mongod, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/the-daily-web

# Any long random string. Used to sign session cookies (P1).
SESSION_SECRET=0db5075dde9211db4b742e8f6972a854e812ad219c9fb59576be6c6a2b001c9a

# External weather service (P5), e.g. an OpenWeatherMap API key.
WEATHER_API_KEY=
WEATHER_CITY=Tel Aviv,IL
