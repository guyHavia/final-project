# Test environment config — committed on purpose, contains NO real secrets.
# Loaded by test.preload.js (`npm test`) before config/env.js is read, so the
# suite never depends on a developer's local .env. Tests use
# mongodb-memory-server; MONGODB_URI is only a placeholder and is never dialled.

NODE_ENV=test
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/the-daily-web-test

# Obvious dummy: signs cookies in tests only. Never use it outside tests.
SESSION_SECRET=test-only-dummy-secret-do-not-use-elsewhere

# WEATHER_API_KEY deliberately unset: tests must never call the real upstream.
WEATHER_CITY=Tel Aviv,IL
