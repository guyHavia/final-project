<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Impact Analytics — The Daily Web</title>
  <link rel="stylesheet" href="/css/newsroom.css" />
</head>
<body>
  <!--
    Thin shell — no article or stats data is rendered server-side (D5). Every
    value below is filled in by public/js/analytics.js after load.
  -->
  <div data-screen="newsroom-analytics">
    <%- include('partials/header', { screen: 'analytics' }) %>

    <main class="page">
      <div class="page-head">
        <div>
          <h1>Impact Analytics</h1>
          <p>See how an update changed reader attention.</p>
        </div>
      </div>

      <div class="an-grid">
        <section class="panel article-picker" aria-label="Choose article">
          <label class="field-label" for="article-search">Article</label>
          <div class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input class="field" id="article-search" type="search" placeholder="Search published articles…" autocomplete="off" />
          </div>
          <ul id="article-results" class="search-results"></ul>
          <p id="search-status" class="muted" role="status" hidden></p>
        </section>

        <section class="panel" aria-label="Views over time">
          <h2 id="selected-article-title" class="selected-title">Pick an article</h2>

          <div class="range-controls">
            <div>
              <label for="bucket-select">Bucket</label>
              <select class="field" id="bucket-select">
                <option value="hour">Hourly</option>
                <option value="day">Daily</option>
              </select>
            </div>
            <div>
              <label for="range-from">From</label>
              <input class="field" id="range-from" type="datetime-local" />
            </div>
            <div>
              <label for="range-to">To</label>
              <input class="field" id="range-to" type="datetime-local" />
            </div>
          </div>

          <p id="range-error" class="field-error" role="alert" hidden></p>

          <div id="chart-area" hidden>
            <div class="chart-area"><canvas id="views-chart"></canvas></div>
            <ol id="marker-legend" class="marker-legend" aria-label="Publish and update markers"></ol>
          </div>
          <p id="empty-message" class="muted empty-state">Search for a published article to see how its views changed over time.</p>
        </section>
      </div>
    </main>
  </div>

  <script src="/vendor/chart.js"></script>
  <script type="module" src="/js/analytics.js"></script>
</body>
</html>
