<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Newsroom review — The Daily Web</title>
  <link rel="stylesheet" href="/css/newsroom.css" />
</head>
<body>
  <!--
    Thin shell — no article data is rendered server-side (D5). Every value
    below is filled in by public/js/newsroom-editor.js after load.
  -->
  <div data-screen="newsroom-editor">
    <header class="newsroom-header">
      <h1>The Daily Web — Newsroom review</h1>
      <div class="header-user">
        <span id="user-display-name"></span>
        <a href="/newsroom/analytics">Impact Analytics</a>
        <button id="logout-button" type="button">Log out</button>
      </div>
    </header>

    <main class="editor-main">
      <section id="article-groups" aria-label="Newsroom queue"></section>

      <section id="review-panel" class="review-panel" hidden>
        <button id="close-review-button" type="button">&larr; Back to queue</button>
        <p id="action-error" role="alert" hidden></p>

        <div class="compare-header">
          <span></span>
          <span>Published</span>
          <span>Pending</span>
        </div>
        <div id="compare-fields"></div>
        <div id="compare-body" class="compare-body"></div>

        <form id="edit-form" hidden>
          <label for="edit-title">Title</label>
          <input id="edit-title" type="text" />
          <label for="edit-category">Category</label>
          <select id="edit-category">
            <option value="politics">politics</option>
            <option value="business">business</option>
            <option value="technology">technology</option>
            <option value="science">science</option>
            <option value="health">health</option>
            <option value="sports">sports</option>
            <option value="entertainment">entertainment</option>
            <option value="world">world</option>
            <option value="opinion">opinion</option>
            <option value="culture">culture</option>
          </select>
          <label for="edit-abstract">Abstract</label>
          <textarea id="edit-abstract" rows="2"></textarea>
          <label for="edit-image">Image URL</label>
          <input id="edit-image" type="text" />
          <label for="edit-body">Body</label>
          <textarea id="edit-body" rows="14"></textarea>
          <div class="edit-form-actions">
            <button id="edit-save-button" type="submit">Save changes</button>
            <button id="edit-cancel-button" type="button">Cancel</button>
          </div>
        </form>

        <div id="action-bar" class="action-bar">
          <button id="approve-button" type="button" hidden>Approve and publish</button>
          <textarea id="return-note" placeholder="Note explaining what needs fixing…" hidden></textarea>
          <button id="return-button" type="button" hidden disabled>Return for corrections</button>
          <button id="edit-button" type="button">Edit</button>
          <button id="delete-button" type="button" class="danger">Delete</button>
        </div>
      </section>
    </main>
  </div>

  <script type="module" src="/js/newsroom-editor.js"></script>
</body>
</html>
