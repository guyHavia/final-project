<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign in — The Daily Web</title>
  <link rel="stylesheet" href="/css/newsroom.css" />
</head>
<body class="login-page">
  <div class="login-art" aria-hidden="true">
    <h2>Stories that move the day.</h2>
    <p>The Daily Web newsroom. Write, review, publish.</p>
  </div>

  <main class="login-card">
    <h1>Sign in</h1>
    <p class="login-subtitle">Reporters and editors only.</p>

    <form id="login-form" novalidate>
      <label for="username">Username</label>
      <input class="field" id="username" name="username" type="text" autocomplete="username" required />

      <label for="password">Password</label>
      <input class="field" id="password" name="password" type="password" autocomplete="current-password" required />

      <button type="submit" class="btn btn-primary">Sign in</button>

      <p id="login-error" role="alert" hidden></p>
    </form>
  </main>

  <script type="module" src="/js/login.js"></script>
</body>
</html>
