<%
  /*
    Public site masthead (home feed, article page, 404): today's date, the site
    name linking home, the dark/light toggle (public/js/theme.js), the
    "Newsroom" link for staff, and a bar of category links that filter the feed.
    `activeCategory` (optional) marks the current category. The newsroom
    screens use partials/header.ejs instead.
  */
  const CATEGORY_LINKS = ['politics', 'business', 'technology', 'science', 'health', 'sports', 'entertainment', 'world', 'opinion', 'culture'];
  const active = locals.activeCategory || '';
  const today = new Date();
%>
<header class="site-header">
  <div class="masthead">
    <div class="masthead-side">
      <time class="masthead-date" datetime="<%= today.toISOString().slice(0, 10) %>"><%= today.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %></time>
    </div>
    <a class="site-name" href="/">The Daily Web</a>
    <div class="masthead-side masthead-actions">
      <button type="button" id="theme-toggle" class="theme-toggle" aria-pressed="false" aria-label="Switch to dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <nav class="site-nav" aria-label="Site">
        <a href="/login">Newsroom</a>
      </nav>
    </div>
  </div>
  <nav class="category-bar" aria-label="Categories">
    <a class="category-link<%= active ? '' : ' is-home' %>" href="/"<% if (!active) { %> aria-current="page"<% } %>>Top stories</a>
    <% for (const category of CATEGORY_LINKS) { %>
    <a class="category-link cat-<%= category %>" href="/?category=<%= category %>"<% if (category === active) { %> aria-current="page"<% } %>><%= category %></a>
    <% } %>
  </nav>
</header>
