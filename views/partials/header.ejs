<%
  /*
    Shared newsroom chrome: hamburger + side menu on the left, account menu on the
    right. `screen` is 'reporter' | 'editor' | 'analytics'. Behaviour: public/js/shell.js.
  */
  const NAV = screen === 'reporter'
    ? [{ key: 'reporter', href: '/newsroom', label: 'My articles', icon: 'pen' }]
    : [
        { key: 'editor', href: '/newsroom/review', label: 'Queue', icon: 'queue' },
        { key: 'analytics', href: '/newsroom/analytics', label: 'Impact Analytics', icon: 'chart' },
      ];
  const home = NAV[0].href;
  const ICONS = {
    queue: '<path d="M4 6h16M4 12h16M4 18h10"/>',
    chart: '<path d="M3 3v18h18"/><path d="m7 15 4-5 3 3 5-7"/>',
    pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  };
%>
<header class="nav">
  <div class="nav-in">
    <button type="button" class="icon-btn burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="sidenav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="logo" href="<%= home %>">The Daily Web</a>
    <span class="spacer"></span>
    <a class="nav-site-link" href="/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg><span>View site</span></a>

    <div class="dd">
      <button type="button" class="dd-btn user-btn" id="user-menu-button" aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" aria-label="Account menu">
        <span class="avatar" id="nav-avatar" aria-hidden="true"></span>
        <span class="user-meta"><b id="user-display-name"></b><span id="user-role-label"></span></span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="dd-menu right" id="user-menu" role="menu" hidden>
        <div class="dd-head"><b id="menu-user-name"></b><span id="menu-user-role"></span></div>
        <button type="button" role="menuitem" id="logout-button" class="danger">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>Log out
        </button>
      </div>
    </div>
  </div>
</header>

<div class="scrim" id="nav-scrim" hidden></div>
<aside class="sidenav" id="sidenav" aria-label="Main menu" hidden>
  <div class="sidenav-head">
    <span class="logo">The Daily Web</span>
    <button type="button" class="icon-btn" id="side-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <nav>
    <% for (const item of NAV) { %>
      <a href="<%= item.href %>"<% if (item.key === screen) { %> aria-current="page"<% } %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- ICONS[item.icon] %></svg><%= item.label %>
      </a>
    <% } %>
    <a class="sidenav-site-link" href="/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>Public site</a>
  </nav>
</aside>
