<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'The Daily Web', description: 'Stories that move the day.', canonical: '/' }) %>
</head>
<body class="public-page">
  <%- include('partials/public-header', { activeCategory }) %>

  <main class="page home-layout">
    <%- include('partials/public-weather') %>

   <div class="home-main">
    <header class="feed-header">
      <h1 id="feed-title"><%= activeCategory ? activeCategory : 'Latest Stories' %></h1>
      <p>The day's breaking news, analysis, and opinion.</p>
    </header>

    <div class="feed-controls panel">
      <div class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <label class="sr" for="feed-search">Search headlines</label>
        <input class="field" id="feed-search" type="search" placeholder="Search headlines…" value="<%= query.q || '' %>" autocomplete="off" />
      </div>

      <div class="filter-group">
        <%# The category is chosen in the masthead's category bar (?category=...);
            feed.js reads it from #feed-bootstrap, so no dropdown is needed here. %>
        <label class="sr" for="feed-sort">Sort by</label>
        <select class="field" id="feed-sort">
          <option value="date" <%= query.sort === 'date' || !query.sort ? 'selected' : '' %>>Newest first</option>
          <option value="popularity" <%= query.sort === 'popularity' ? 'selected' : '' %>>Most read</option>
        </select>

        <label class="sr" for="feed-viewed">Show</label>
        <select class="field" id="feed-viewed">
          <option value="all" selected>All stories</option>
          <option value="unviewed">Not viewed</option>
          <option value="viewed">Viewed</option>
        </select>
      </div>
    </div>

    <section id="article-feed-section" aria-label="Published articles">
      <ul id="article-card-list" class="article-cards">
        <% if (items && items.length > 0) { %>
          <% for (const item of items) { %>
            <li class="article-card" data-id="<%= item.id %>" data-slug="<%= item.slug %>">
              <% if (item.image) { %>
                <figure class="card-thumb">
                  <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy" />
                </figure>
              <% } %>
              <div class="card-content">
                <span class="card-category cat-<%= item.category %>"><%= item.category %></span>
                <h2 dir="auto"><a href="/article/<%= item.slug || item.id %>"><%= item.title %></a></h2>
                <% if (item.abstract) { %>
                  <p class="card-abstract" dir="auto"><%= item.abstract %></p>
                <% } %>
                <div class="card-meta">
                  <span class="byline"><%= item.author.displayName %></span>
                  <span>&bull;</span>
                  <time datetime="<%= new Date(item.publishedAt).toISOString() %>"><%= new Date(item.publishedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %></time>
                  <span>&bull;</span>
                  <span class="view-count"><%= item.viewCount %> views</span>
                </div>
              </div>
            </li>
          <% } %>
        <% } else { %>
          <li class="empty-state">
            <p>No published articles found matching your criteria.</p>
          </li>
        <% } %>
      </ul>

      <div id="feed-status" class="feed-status" role="status" aria-live="polite">
        <button id="retry-btn" class="btn btn-secondary" hidden>Retry loading more</button>
        <p id="end-of-feed-msg" class="muted" <%= nextCursor ? 'hidden' : '' %>>You've reached the end of the feed.</p>
      </div>
      <div id="scroll-sentinel" aria-hidden="true"></div>
    </section>
   </div>

    <%- include('partials/public-most-read', { mostRead }) %>
  </main>

  <%- include('partials/footer') %>

  <!-- Hidden bootstrap data for client hydration -->
  <div id="feed-bootstrap" hidden data-next-cursor="<%= nextCursor || '' %>" data-query-q="<%= query.q || '' %>" data-query-category="<%= query.category || '' %>" data-query-sort="<%= query.sort || 'date' %>"></div>

  <script type="module" src="/js/feed.js"></script>
  <script type="module" src="/js/weather.js"></script>
</body>
</html>