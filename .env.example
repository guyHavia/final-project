# Copy to .env and fill in. .env is git-ignored — never commit real values.

NODE_ENV=development
PORT=3000

# MongoDB connection string (shared by the app and the session store).
MONGODB_URI=

# Secret used to sign the session cookie. Use a long random string.
SESSION_SECRET=

# Weather integration (P5).
WEATHER_API_KEY=
WEATHER_CITY=Tel Aviv,IL
