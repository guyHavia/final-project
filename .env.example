# Copy to .env and fill in the blanks. NEVER commit .env.
# Start MongoDB locally: docker compose up -d  (see docker-compose.yml)

NODE_ENV=development
PORT=3000

# MongoDB: run `docker compose up -d` for a local instance, or paste an Atlas URL.
MONGODB_URI=mongodb://127.0.0.1:27017/the-daily-web

# Any long random string. Used to sign session cookies (P1).
SESSION_SECRET=

# External weather service (P5), e.g. an OpenWeatherMap API key.
WEATHER_API_KEY=
WEATHER_CITY=Tel Aviv,IL

# Optional: fix the password for seed users. If unset, a random one is generated
# and printed to the console at the end of `npm run seed`.
SEED_PASSWORD=
