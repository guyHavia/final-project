# Copy to .env and fill in the blanks. NEVER commit .env.

NODE_ENV=development
PORT=3000

# MongoDB: a local mongod, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/the-daily-web

# Signs session cookies (P1). 512 random bits; generate with: openssl rand -hex 64
# Production refuses to start with anything shorter than 128 characters.
SESSION_SECRET=

# External weather service (P5), e.g. an OpenWeatherMap API key.
WEATHER_API_KEY=
WEATHER_CITY=Tel Aviv,IL

# Set when running behind a reverse proxy/TLS terminator so secure cookies work:
# a hop count (1), 'loopback', or a CIDR. Leave unset when not behind a proxy.
TRUST_PROXY=
